# URL base da API. Em dev, o proxy do Vite (vite.config.ts) ja encaminha
# /api para o backend em localhost:3333, entao esta variavel so precisa ser
# definida em producao, onde frontend e backend sao dois projetos Vercel
# separados (dominios diferentes) - aponte para a URL do projeto backend
# incluindo o /api final, ex:
# VITE_API_URL=https://gestaoimoveis-backend.vercel.app/api
VITE_API_URL=/api
