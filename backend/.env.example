# Banco de dados
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="troque_por_um_segredo_forte_de_acesso"
JWT_REFRESH_SECRET="troque_por_um_segredo_forte_de_refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Servidor
PORT=3333
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:5173"

# Uploads
UPLOADS_DIR="./uploads"

# Email (aprovacao de contratos, credenciais de novo proprietario, etc.)
# Quando EMAIL_MOCK=true, nenhum SMTP real e usado: o email e apenas logado
# no console e gravado na tabela EmailEnviado (tela "Emails Enviados").
EMAIL_MOCK=true
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Sistema de Alugueis <no-reply@sistema-alugueis.local>"
