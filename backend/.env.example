# Banco de dados (PostgreSQL via Supabase)
# DATABASE_URL: connection string via pooler (Supavisor/pgbouncer, porta 6543)
# - usada em runtime pela aplicacao (necessario em ambiente serverless/Vercel,
# onde cada invocacao abre uma conexao nova - sem pooler o Postgres esgota
# conexoes rapido). Pegue essa string em Supabase > Project Settings >
# Database > Connection string > "Transaction" pooling mode.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# DIRECT_URL: conexao direta (porta 5432) - usada so pelo `prisma migrate`
# (migrations precisam de conexao direta, o pooler em modo transaction nao
# suporta alguns comandos DDL usados durante a migration).
DIRECT_URL="postgresql://postgres:SUA_SENHA@db.xxxxxxxxxxxx.supabase.co:5432/postgres?sslmode=require"

# JWT
JWT_SECRET="troque_por_um_segredo_forte_de_acesso"
JWT_REFRESH_SECRET="troque_por_um_segredo_forte_de_refresh"
JWT_ACCESS_EXPIRES_IN="10m"
JWT_REFRESH_EXPIRES_IN="7d"

# Servidor
PORT=3333
NODE_ENV=development

# CORS (aceita lista separada por virgula, ex: dominio de producao + previews da Vercel)
CORS_ORIGIN="http://localhost:5173"

# Supabase Storage (uploads/PDFs gerados - ver src/lib/storage.ts). Necessario
# criar um bucket PUBLICO chamado "uploads" no projeto Supabase antes do
# primeiro uso (Storage > New bucket > "uploads" > Public bucket).
# SUPABASE_SECRET_KEY e a service role key (Settings > API) - da acesso total
# ao bucket, ignorando RLS; nunca expor ao frontend.
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx"

# Email (aprovacao de contratos, credenciais de novo proprietario, etc.)
# Quando EMAIL_MOCK=true, nenhum SMTP real e usado: o email e apenas logado
# no console e gravado na tabela EmailEnviado (tela "Emails Enviados").
EMAIL_MOCK=true
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ImovelClaro <no-reply@imovelclaro.local>"

# Bootstrap do Proprietario padrao (ver prisma/bootstrap.ts, chamado no
# postinstall). So tem efeito se o banco ainda nao tiver NENHUM Proprietario -
# idempotente, seguro de rodar em todo deploy. Troque a senha assim que
# possivel: a conta ja nasce com precisaTrocarSenha=true, forcando a troca no
# primeiro login.
PROPRIETARIO_PADRAO_EMAIL="admin@imovelclaro.com"
PROPRIETARIO_PADRAO_SENHA="troque-por-uma-senha-forte-antes-do-primeiro-deploy"
