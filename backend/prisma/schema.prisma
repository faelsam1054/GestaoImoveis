// Schema do sistema de gestao de alugueis
// Campos de "opcoes fixas" sao String (nao enum nativo do Postgres) por
// heranca do datasource original (SQLite, que nao suporta enum) - validados
// via Zod na camada de aplicacao. Valores permitidos ficam documentados em
// comentario ao lado do campo. Mantido como String deliberadamente na
// migracao para Postgres (converter pra enum nativo e uma melhoria separada,
// nao uma correcao obrigatoria - ver README, secao de deploy).

generator client {
  provider      = "prisma-client-js"
  // "native" gera o engine para a maquina local (Windows, dev); a Vercel
  // roda em Amazon Linux (Node runtime serverless) - sem esse segundo
  // target o client funciona local mas quebra em runtime na Vercel.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // conexao via pooler (Supavisor/pgbouncer) - usada em runtime
  directUrl = env("DIRECT_URL")   // conexao direta - usada so pelo `prisma migrate`
}

// ── Usuarios e autenticacao ─────────────────────────────────────────────

model Usuario {
  id                 String   @id @default(cuid())
  nome               String
  email              String   @unique
  senhaHash          String
  role               String // proprietario | administrador | inquilino
  telefone           String?
  ativo              Boolean   @default(true)
  desativadoEm       DateTime? // timestamp da ultima desativacao (auditoria/consistencia); nao afeta login, so o campo "ativo" faz isso
  precisaTrocarSenha Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  permissaoAdministrador  PermissaoAdministrador?
  pagamentosComoAdmin     PagamentoAdministrador[] @relation("AdministradorPagamentos")
  inquilino               Inquilino?
  refreshTokens           RefreshToken[]
  logsAuditoria           LogAuditoria[]
  recibosGerados          ReciboPdf[]              @relation("GeradoPor")
  imoveisVinculados       AdminImovel[]            @relation("AdminImoveisDoAdministrador")
  contratosCriados        Contrato[]               @relation("ContratoCriadoPor")
  contratosAprovados      Contrato[]               @relation("ContratoAprovadoPor")
  aditivosCriados         AditivoContrato[]
  notificacoes            Notificacao[]

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([usuarioId])
}

// ── Permissoes granulares do Administrador ──────────────────────────────

model PermissaoAdministrador {
  id        String  @id @default(cuid())
  usuarioId String  @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  podeVerImoveis          Boolean @default(false)
  podeEditarImoveis       Boolean @default(false)
  podeVerInquilinos       Boolean @default(false)
  podeEditarInquilinos    Boolean @default(false)
  podeVerContratos        Boolean @default(false)
  podeEditarContratos     Boolean @default(false)
  podeVerPagamentos       Boolean @default(false)
  podeRegistrarPagamentos Boolean @default(false)
  podeVerManutencao       Boolean @default(false)
  podeCadastrarManutencao Boolean @default(false)
  podeVerAdministradores  Boolean @default(false)
  podeEditarPerfil        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Imoveis ──────────────────────────────────────────────────────────────

model TipoImovel {
  id        String   @id @default(cuid())
  nome      String   @unique
  descricao String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  imoveis Imovel[]
}

model Imovel {
  id           String     @id @default(cuid())
  tipoImovelId String
  tipoImovel   TipoImovel @relation(fields: [tipoImovelId], references: [id])

  logradouro String
  numero     String
  complemento String?
  bairro     String
  cidade     String
  estado     String
  cep        String

  valorAluguelBase Float
  descricao        String?
  status           String    @default("vago") // vago | alugado | manutencao | inativo
  excluidoEm       DateTime? // soft delete: preenchido = imovel excluido, oculto das listagens padrao

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fotos              ImovelFoto[]
  contratos          Contrato[]
  gastosManutencao   GastoManutencao[]
  administradoresVinculados AdminImovel[]

  @@index([tipoImovelId])
  @@index([status])
}

// Vinculo N:N entre Administrador e Imovel: define a quais imoveis cada
// administrador tem acesso. Proprietario nunca passa por esta tabela (RBAC
// da bypass total a ele). Ver acesso-imovel.service.ts para a logica de uso.
model AdminImovel {
  id              String   @id @default(cuid())
  administradorId String
  administrador   Usuario  @relation("AdminImoveisDoAdministrador", fields: [administradorId], references: [id], onDelete: Cascade)
  imovelId        String
  imovel          Imovel   @relation(fields: [imovelId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([administradorId, imovelId])
  @@index([administradorId])
  @@index([imovelId])
}

model ImovelFoto {
  id        String   @id @default(cuid())
  imovelId  String
  imovel    Imovel   @relation(fields: [imovelId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())

  @@index([imovelId])
}

// ── Inquilinos e contratos ───────────────────────────────────────────────

model Inquilino {
  id        String  @id @default(cuid())
  usuarioId String  @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  cpf                       String  @unique
  telefone                  String
  contatoEmergenciaNome     String?
  contatoEmergenciaTelefone String?
  excluidoEm                DateTime? // soft delete: preenchido = inquilino excluido, oculto das listagens padrao

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contratos Contrato[]
}

model Contrato {
  id          String    @id @default(cuid())
  imovelId    String
  imovel      Imovel    @relation(fields: [imovelId], references: [id])
  inquilinoId String
  inquilino   Inquilino @relation(fields: [inquilinoId], references: [id])

  dataInicio    DateTime
  dataFim       DateTime
  diaVencimento Int
  valorAluguel  Float
  valorCaucao   Float?
  // 1 (padrao): caucao continua sendo um unico Pagamento tipo=caucao, como sempre foi.
  // 2 ou 3: gera registros em CaucaoParcela em vez do Pagamento avulso (ver contratos.service.ts).
  caucaoNumeroParcelas Int @default(1)

  // Campo unico de estado (fundido com o antigo "statusAprovacao" - ver
  // migration contrato_status_unificado): contrato criado pelo Proprietario
  // nasce ja "ativo"; criado por Administrador nasce "pendente_aprovacao" -
  // so passa a gerar pagamentos, ocupar o imovel e ganhar o PDF quando o
  // Proprietario aprova (vira "ativo") ou "rejeitado" (ver contratos.service.ts:
  // criar/aprovar/rejeitar). "encerrado" e setado apenas pelo endpoint /encerrar.
  status String @default("ativo") // pendente_aprovacao | ativo | rejeitado | encerrado

  motivoRejeicao  String?
  dataRejeicao    DateTime?
  dataAprovacao   DateTime?
  criadoPorId     String?
  criadoPor       Usuario?  @relation("ContratoCriadoPor", fields: [criadoPorId], references: [id])
  aprovadoPorId   String?
  aprovadoPor     Usuario?  @relation("ContratoAprovadoPor", fields: [aprovadoPorId], references: [id])

  // Auto-relacao para renovacao: o novo contrato aponta para o anterior.
  contratoAnteriorId String?   @unique
  contratoAnterior   Contrato? @relation("RenovacaoContrato", fields: [contratoAnteriorId], references: [id])
  contratoRenovado   Contrato? @relation("RenovacaoContrato")

  arquivoPdfUrl      String? // gerado automaticamente pelo sistema ao criar/renovar o contrato
  contratoAssinadoUrl String? // PDF do contrato assinado, enviado manualmente pelo proprietario/administrador
  quebraContratoUrl   String? // PDF de quebra de contrato, opcional, anexado so no momento do encerramento antecipado

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pagamentos     Pagamento[]
  caucaoParcelas CaucaoParcela[]
  aditivos       AditivoContrato[] @relation("AditivoDoContrato")

  @@index([imovelId])
  @@index([inquilinoId])
  @@index([status])
}

// Registro historico de uma alteracao contratual pontual (reajuste de valor,
// mudanca de dia de vencimento, prorrogacao de data fim) OU um documento
// anexado a titulo de registro. Aplicado sempre no MESMO Contrato (nunca cria
// um contrato novo - isso e renovar(), feature separada). Cada campo "Anterior"
// so e preenchido quando aquele campo especifico foi alterado por este aditivo;
// os que nao mudaram ficam null. Imutavel apos criado (nao ha update, so create).
model AditivoContrato {
  id         String @id @default(cuid())
  contratoId String
  contrato   Contrato @relation("AditivoDoContrato", fields: [contratoId], references: [id])

  // Motivo/descricao do aditivo (obrigatorio mesmo quando nao muda nenhum
  // campo estruturado - todo aditivo precisa de uma justificativa registrada).
  descricaoAlteracoes String
  // Serve tambem como "data de efetivacao" das mudancas - editavel no
  // formulario (default hoje), distinto de createdAt (timestamp imutavel da
  // insercao no banco).
  dataAditivo DateTime @default(now())

  arquivoPdfUrl String? // opcional - nem todo aditivo tem PDF anexado

  valorAluguelAnterior  Float?
  valorAluguelNovo      Float?
  diaVencimentoAnterior Int?
  diaVencimentoNovo     Int?
  dataFimAnterior       DateTime?
  dataFimNovo           DateTime?

  criadoPorId String
  criadoPor   Usuario @relation(fields: [criadoPorId], references: [id])

  createdAt DateTime @default(now())

  @@index([contratoId])
}

// ── Financeiro: caucao parcelada (usada quando Contrato.caucaoNumeroParcelas > 1) ─

model CaucaoParcela {
  id         String   @id @default(cuid())
  contratoId String
  contrato   Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  numeroParcela  Int
  valorParcela   Float
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         String  @default("pendente") // pendente | pago | atrasado
  formaPagamento String? // pix | transferencia | dinheiro | outros
  observacoes    String?
  reciboPdfUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contratoId, numeroParcela])
  @@index([contratoId])
  @@index([status])
}

// ── Financeiro: pagamentos de aluguel ────────────────────────────────────

model Pagamento {
  id         String   @id @default(cuid())
  contratoId String
  contrato   Contrato @relation(fields: [contratoId], references: [id])

  tipo           String // aluguel | caucao | multa | outro
  competencia    String // formato "YYYY-MM"
  valorPrevisto  Float
  valorPago      Float?
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         String  @default("pendente") // pendente | pago | atrasado
  formaPagamento String? // pix | transferencia | dinheiro | boleto | outro
  observacoes    String?

  comprovanteUrl          String? // PDF ou imagem (jpg/png) do comprovante, opcional
  comprovanteNomeOriginal String? // nome do arquivo enviado pelo usuario, para exibir na UI
  comprovanteTamanho      Int? // bytes, para exibir na UI
  comprovanteUploadEm     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recibo ReciboPdf?

  @@index([contratoId])
  @@index([competencia])
  @@index([status])
}

// ── Financeiro: manutencao de imoveis ────────────────────────────────────

model GastoManutencao {
  id       String @id @default(cuid())
  imovelId String
  imovel   Imovel @relation(fields: [imovelId], references: [id])

  descricao    String
  categoria    String // pintura | eletrica | hidraulica | estrutural | limpeza | jardinagem | outros
  valor        Float
  dataExecucao DateTime?

  prestadorNome      String?
  prestadorDocumento String?
  prestadorTelefone  String?

  status            String    @default("orcamento") // orcamento | aprovado | executado | pago
  dataPagamento     DateTime?
  formaPagamento    String? // pix | transferencia | dinheiro | boleto | outro
  comprovantePdfUrl String?
  comprovanteNomeOriginal String? // nome do arquivo enviado pelo usuario, para exibir na UI
  comprovanteTamanho   Int? // bytes, para exibir na UI (ex: "230 KB")
  comprovanteUploadEm  DateTime?
  observacoes       String?

  // Diferencia gasto criado pelo proprietario de chamado aberto pelo inquilino.
  origem String @default("proprietario") // proprietario | chamado_inquilino

  // Soft delete: preenchido = excluido, oculto das listagens padrao (mesmo
  // padrao do Inquilino). Nao ha "reativar" pedido para este modulo ainda.
  excluidoEm DateTime?

  // Recorrencia: so tem sentido no registro "origem" (manutencaoOrigemId
  // null). As instancias geradas automaticamente (ver gerarProximasRecorrencias
  // em manutencao.service.ts) apontam de volta pra origem via manutencaoOrigemId
  // e nascem sempre com recorrencia="unica" - nao viram origem de uma nova
  // cadeia. Cada instancia e editada/excluida de forma independente (nao ha
  // "aplicar a todas as futuras").
  recorrencia         String    @default("unica") // unica | mensal | trimestral | semestral | anual
  dataFimRecorrencia  DateTime?
  ativo               Boolean   @default(true) // false = recorrencia pausada, para de gerar novas instancias
  manutencaoOrigemId  String?
  manutencaoOrigem    GastoManutencao?  @relation("RecorrenciaManutencao", fields: [manutencaoOrigemId], references: [id])
  manutencoesGeradas  GastoManutencao[] @relation("RecorrenciaManutencao")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([imovelId])
  @@index([status])
  @@index([categoria])
  @@index([manutencaoOrigemId])
  // Cinturao de seguranca contra corrida em gerarProximasRecorrencias():
  // chamadas concorrentes a listar() nao devem conseguir criar duas
  // instancias para o mesmo mes da mesma origem recorrente, mesmo se a
  // logica de aplicacao falhar em evitar isso (ver manutencao.service.ts).
  @@unique([manutencaoOrigemId, dataExecucao])
}

// ── Financeiro: mensalidade do administrador ─────────────────────────────
// Visivel/editavel apenas pelo Proprietario (regra aplicada no RBAC, nao no schema).

// Mensalidade e sempre calculada pelo sistema (nunca criada manualmente - ver
// pagamentos-admin.service.ts: calcular). O registro so passa a existir
// quando todos os inquilinos dos imoveis do administrador ja pagaram o
// aluguel do mes; os campos abaixo (quantidadeImoveis/valorTotalAlugueis/
// percentual/valorPrevisto) sao um snapshot do calculo naquele momento, para
// o historico nao mudar se os vinculos do administrador mudarem depois.
model PagamentoAdministrador {
  id              String  @id @default(cuid())
  administradorId String
  administrador   Usuario @relation("AdministradorPagamentos", fields: [administradorId], references: [id])

  mesReferencia      String // formato "YYYY-MM"
  quantidadeImoveis  Int
  valorTotalAlugueis Float
  percentual         Float // percentual aplicado sobre valorTotalAlugueis (hoje sempre 10)
  valorPrevisto      Float // = valorTotalAlugueis * percentual / 100

  valorPago      Float?
  dataPagamento  DateTime?
  dataVencimento DateTime
  status         String  @default("aguardando_pagamento") // aguardando_pagamento | pago | atrasado
  formaPagamento String? // pix | transferencia | dinheiro
  observacoes    String?
  comprovantePdfUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([administradorId, mesReferencia])
  @@index([administradorId])
  @@index([mesReferencia])
}

// ── PDFs gerados ──────────────────────────────────────────────────────────

model ReciboPdf {
  id          String    @id @default(cuid())
  pagamentoId String?   @unique
  pagamento   Pagamento? @relation(fields: [pagamentoId], references: [id])

  tipo           String // recibo_pagamento | contrato
  caminhoArquivo String
  geradoEm       DateTime @default(now())

  geradoPorId String
  geradoPor   Usuario @relation("GeradoPor", fields: [geradoPorId], references: [id])
}

// ── Auditoria ────────────────────────────────────────────────────────────

model LogAuditoria {
  id        String   @id @default(cuid())
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  acao       String // ex: CREATE_IMOVEL | UPDATE_PAGAMENTO | DELETE_CONTRATO
  entidade   String // ex: Imovel, Pagamento, Contrato
  entidadeId String?

  // JSON serializado manualmente como String (heranca do datasource original,
  // SQLite, que nao suporta o tipo Json no Prisma). Postgres suporta Json
  // nativo, mas mantido como String deliberadamente por ora - ver comentario
  // no topo do arquivo.
  dadosAntes  String?
  dadosDepois String?

  ip        String?
  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([entidade, entidadeId])
}

// ── Emails (mock/real, ver email.service.ts) ────────────────────────────

model EmailEnviado {
  id            String   @id @default(cuid())
  destinatario  String
  assunto       String
  corpo         String
  modoMock      Boolean  @default(true) // true = apenas logado/gravado, sem SMTP real
  enviadoEm     DateTime @default(now())

  @@index([enviadoEm])
}

model Notificacao {
  id        String  @id @default(cuid())
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  tipo     String // ex: CONTRATO_REJEITADO - string livre para permitir novos tipos sem migration
  titulo   String
  mensagem String

  // Origem opcional, para a UI poder linkar de volta (ex: entidade="Contrato", entidadeId=<id>)
  entidade   String?
  entidadeId String?

  lida      Boolean   @default(false)
  lidaEm    DateTime?
  createdAt DateTime  @default(now())

  @@index([usuarioId, lida])
}
